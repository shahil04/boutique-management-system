# Gemini API key for Hindi & English tailoring slip Vision OCR
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# WhatsApp Business Cloud API (required to send receipt PDFs directly)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional Graph API version override (default: v27.0)
WHATSAPP_GRAPH_API_VERSION=v27.0
# Optional approved utility template with a document header (needed outside 24-hour window)
WHATSAPP_RECEIPT_TEMPLATE_NAME=
WHATSAPP_RECEIPT_TEMPLATE_LANGUAGE=en
